# Copy to .env. scripts/local_postgres.py creates a private local instance and .env.
DATABASE_URL=postgresql+psycopg://ops_user:CHANGE_ME@127.0.0.1:55432/ops_intelligence
POSTGRES_USER=ops_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ops_intelligence
AI_PROVIDER=evidence
# evidence = real data tools, no generated prose. ollama = local LLM. openai = API.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
