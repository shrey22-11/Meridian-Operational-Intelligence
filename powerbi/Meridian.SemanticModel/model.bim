      {
        "name": "Date",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy",
            "isKey": true
          },
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month",
            "summarizeBy": "none"
          },
          {
            "name": "Year",
            "dataType": "int64",
            "sourceColumn": "Year",
            "summarizeBy": "none",
            "formatString": "#,0"
          }
        ],
        "partitions": [
          {
            "name": "Date",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Start = List.Min(Orders[ordered_at]),\n    End = List.Max(Forecast[day]),\n    Dates = Table.FromList(List.Dates(Start,Duration.Days(End-Start)+1,#duration(1,0,0,0)),Splitter.SplitByNothing(),{\"Date\"}),\n    Typed = Table.TransformColumnTypes(Dates,{{\"Date\",type date}}),\n    Month = Table.AddColumn(Typed,\"Month\",each Date.ToText([Date],\"yyyy-MM\"),type text),\n    Year = Table.AddColumn(Month,\"Year\",each Date.Year([Date]),Int64.Type)\nin Year"
            }
          }
        ],
        "dataCategory": "Time"
      },
      {
        "name": "Region",
        "columns": [
          {
            "name": "region",
            "dataType": "string",
