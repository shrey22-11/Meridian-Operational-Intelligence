        ],
        "partitions": [
          {
            "name": "Model",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    J = Json.Document(File.Contents(ProjectRoot & \"/artifacts/model_report.json\")),\n    T = Table.FromRecords({[risk_model=J[risk][selected], threshold=J[risk][threshold], risk_auc=J[risk][test][roc_auc], risk_precision=J[risk][test][precision], risk_recall=J[risk][test][recall], forecast_model=J[forecast][selected], forecast_mae=J[forecast][test][mae], baseline_mae=J[forecast][seasonal_baseline_test][mae], run_id=J[pipeline_run_id], created_at=J[created_at]]})\nin T"
            }
          }
        ]
      },
