{
  "name": "Meridian",
  "compatibilityLevel": 1606,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "expressions": [
      {
        "name": "ProjectRoot",
        "kind": "m",
        "expression": "\"C:/Shrey_Pandey/Vibecode/AI_Operational_Intelligence\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "ReadCsv",
        "kind": "m",
        "expression": "(file as text, types as list) as table => let\n    Source = Csv.Document(File.Contents(ProjectRoot & \"/data/exports/\" & file & \".csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n    Nulls = Table.ReplaceValue(Headers,\"\",null,Replacer.ReplaceValue,Table.ColumnNames(Headers)),\n    Typed = Table.TransformColumnTypes(Nulls,types,\"en-US\")\nin Typed"
      },
      {
        "name": "SourceOrderFacts",
        "kind": "m",
        "expression": "ReadCsv(\"order_facts\", {{\"order_id\", Int64.Type}, {\"customer_id\", Int64.Type}, {\"ordered_at\", type date}, {\"promised_days\", Int64.Type}, {\"actual_days\", type number}, {\"warehouse_load\", type number}, {\"distance_km\", type number}, {\"expedited\", type logical}, {\"status\", type text}, {\"region\", type text}, {\"channel\", type text}, {\"revenue\", type number}, {\"gross_margin\", type number}, {\"units\", Int64.Type}, {\"line_count\", Int64.Type}, {\"supplier_lead_days\", type number}, {\"late\", type number}})"
      },
      {
        "name": "SourceCustomers",
        "kind": "m",
        "expression": "ReadCsv(\"customers\", {{\"customer_id\", Int64.Type}, {\"region\", type text}, {\"channel\", type text}, {\"joined_at\", type date}})"
      },
      {
        "name": "SourceSegments",
        "kind": "m",
        "expression": "ReadCsv(\"segments\", {{\"customer_id\", Int64.Type}, {\"last_order\", type date}, {\"frequency\", Int64.Type}, {\"monetary\", type number}, {\"late_rate\", type number}, {\"recency\", Int64.Type}, {\"cluster\", Int64.Type}, {\"segment\", type text}})"
      },
      {
        "name": "SourceProducts",
        "kind": "m",
        "expression": "ReadCsv(\"products\", {{\"product_id\", Int64.Type}, {\"supplier_id\", Int64.Type}, {\"product_name\", type text}, {\"category\", type text}, {\"unit_cost\", type number}, {\"list_price\", type number}})"
      },
      {
        "name": "SourceSuppliers",
        "kind": "m",
        "expression": "ReadCsv(\"suppliers\", {{\"supplier_id\", Int64.Type}, {\"supplier_name\", type text}, {\"lead_time_days\", Int64.Type}})"
      },
      {
        "name": "SourceOrderItems",
        "kind": "m",
        "expression": "ReadCsv(\"order_items\", {{\"order_item_id\", Int64.Type}, {\"order_id\", Int64.Type}, {\"product_id\", Int64.Type}, {\"quantity\", Int64.Type}, {\"unit_price\", type number}, {\"discount\", type number}})"
      },
      {
        "name": "SourceScoredOrders",
        "kind": "m",
        "expression": "ReadCsv(\"scored_orders\", {{\"order_id\", Int64.Type}, {\"customer_id\", Int64.Type}, {\"ordered_at\", type date}, {\"promised_days\", Int64.Type}, {\"actual_days\", type number}, {\"warehouse_load\", type number}, {\"distance_km\", type number}, {\"expedited\", type logical}, {\"status\", type text}, {\"region\", type text}, {\"channel\", type text}, {\"revenue\", type number}, {\"gross_margin\", type number}, {\"units\", Int64.Type}, {\"line_count\", Int64.Type}, {\"supplier_lead_days\", type number}, {\"late\", type number}, {\"risk_probability\", type number}, {\"risk_level\", type text}})"
      },
      {
        "name": "SourceDailyOperations",
        "kind": "m",
        "expression": "ReadCsv(\"daily_operations\", {{\"day\", type date}, {\"region\", type text}, {\"orders\", Int64.Type}, {\"revenue\", type number}, {\"gross_margin\", type number}, {\"units\", Int64.Type}, {\"late_rate\", type number}, {\"warehouse_load\", type number}})"
      },
      {
        "name": "SourceAnomalies",
        "kind": "m",
        "expression": "ReadCsv(\"anomalies\", {{\"day\", type date}, {\"region\", type text}, {\"orders\", Int64.Type}, {\"revenue\", type number}, {\"gross_margin\", type number}, {\"units\", Int64.Type}, {\"late_rate\", type number}, {\"warehouse_load\", type number}, {\"anomaly_score\", type number}, {\"is_anomaly\", type logical}, {\"main_deviation\", type text}, {\"deviation_z\", type number}, {\"period\", type text}})"
      },
      {
        "name": "SourceForecast",
        "kind": "m",
        "expression": "ReadCsv(\"forecast\", {{\"day\", type date}, {\"units\", type number}, {\"lower\", type number}, {\"upper\", type number}})"
      },
      {
        "name": "SourceForecastBacktest",
        "kind": "m",
        "expression": "ReadCsv(\"forecast_backtest\", {{\"day\", type date}, {\"actual\", type number}, {\"prediction\", type number}, {\"seasonal_baseline\", type number}})"
      }
    ],
    "tables": [
      {
        "name": "Orders",
        "columns": [
          {
            "name": "order_id",
            "dataType": "int64",
            "sourceColumn": "order_id",
            "summarizeBy": "none",
            "formatString": "#,0"
          },
          {
            "name": "customer_id",
            "dataType": "int64",
            "sourceColumn": "customer_id",
            "summarizeBy": "none",
            "formatString": "#,0"
          },
          {
            "name": "ordered_at",
            "dataType": "dateTime",
            "sourceColumn": "ordered_at",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy"
          },
          {
            "name": "promised_days",
            "dataType": "int64",
            "sourceColumn": "promised_days",
            "summarizeBy": "none",
            "formatString": "#,0"
          },
          {
            "name": "actual_days",
            "dataType": "double",
            "sourceColumn": "actual_days",
            "summarizeBy": "none",
            "formatString": "#,0.00"
          },
          {
            "name": "warehouse_load",
            "dataType": "double",
            "sourceColumn": "warehouse_load",
            "summarizeBy": "none",
            "formatString": "#,0.00"
          },
          {
            "name": "distance_km",
            "dataType": "double",
            "sourceColumn": "distance_km",
            "summarizeBy": "none",
            "formatString": "#,0.00"
          },
          {
            "name": "expedited",
            "dataType": "boolean",
            "sourceColumn": "expedited",
            "summarizeBy": "none"
          },
          {
            "name": "status",
            "dataType": "string",
            "sourceColumn": "status",
            "summarizeBy": "none"
          },
          {
            "name": "region",
            "dataType": "string",
            "sourceColumn": "region",
            "summarizeBy": "none"
          },
          {
            "name": "channel",
            "dataType": "string",
            "sourceColumn": "channel",
            "summarizeBy": "none"
          },
          {
            "name": "revenue",
            "dataType": "double",
            "sourceColumn": "revenue",
            "summarizeBy": "none",
            "formatString": "#,0.00"
          },
          {
            "name": "gross_margin",
            "dataType": "double",
            "sourceColumn": "gross_margin",
            "summarizeBy": "none",
            "formatString": "#,0.00"
          },
          {
            "name": "units",
            "dataType": "int64",
            "sourceColumn": "units",
            "summarizeBy": "none",
            "formatString": "#,0"
          },
          {
            "name": "line_count",
            "dataType": "int64",
            "sourceColumn": "line_count",
            "summarizeBy": "none",
            "formatString": "#,0"
          },
          {
            "name": "supplier_lead_days",
            "dataType": "double",
            "sourceColumn": "supplier_lead_days",
            "summarizeBy": "none",
            "formatString": "#,0.00"
          },
          {
            "name": "late",
            "dataType": "double",
            "sourceColumn": "late",
            "summarizeBy": "none",
            "formatString": "#,0.00"
          }
        ],
        "partitions": [
          {
            "name": "Orders",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "SourceOrderFacts"
            }
          }
        ],
        "measures": [
          {
            "name": "Booked Revenue",
            "expression": "COALESCE(CALCULATE(SUM(Orders[revenue]), KEEPFILTERS(Orders[status] <> \"cancelled\")),0)",
            "formatString": "\"â‚¹\" #,0.00;(\"â‚¹\" #,0.00);\"â‚¹\" 0.00",
            "displayFolder": "Commercial",
            "description": "Booked Revenue"
          },
          {
            "name": "Gross Margin",
            "expression": "COALESCE(CALCULATE(SUM(Orders[gross_margin]), KEEPFILTERS(Orders[status] <> \"cancelled\")),0)",
            "formatString": "\"â‚¹\" #,0.00;(\"â‚¹\" #,0.00);\"â‚¹\" 0.00",
            "displayFolder": "Commercial",
            "description": "Gross Margin"
          },
          {
            "name": "Margin Rate",
            "expression": "DIVIDE([Gross Margin],[Booked Revenue])",
            "formatString": "0.0%",
            "displayFolder": "Commercial",
            "description": "Margin Rate"
          },
          {
            "name": "Orders Received",
            "expression": "COALESCE(COUNTROWS(Orders),0)",
            "formatString": "#,0",
            "displayFolder": "Commercial",
            "description": "Orders Received"
          },
          {
            "name": "Booked Orders",
            "expression": "CALCULATE(COUNTROWS(Orders),KEEPFILTERS(Orders[status] <> \"cancelled\"))",
            "formatString": "#,0",
            "displayFolder": "Commercial",
            "description": "Booked Orders"
          },
          {
            "name": "Average Basket",
            "expression": "DIVIDE([Booked Revenue],[Booked Orders])",
            "formatString": "\"â‚¹\" #,0.00;(\"â‚¹\" #,0.00);\"â‚¹\" 0.00",
            "displayFolder": "Commercial",
            "description": "Average Basket"
          },
          {
            "name": "Delivered Orders",
            "expression": "COALESCE(CALCULATE(COUNTROWS(Orders),KEEPFILTERS(Orders[status] = \"delivered\")),0)",
            "formatString": "#,0",
            "displayFolder": "Commercial",
            "description": "Delivered Orders"
          },
          {
            "name": "Late Deliveries",
            "expression": "COALESCE(CALCULATE(COUNTROWS(Orders),KEEPFILTERS(Orders[status] = \"delivered\"),Orders[late] = 1),0)",
            "formatString": "#,0",
            "displayFolder": "Commercial",
            "description": "Late Deliveries"
          },
          {
            "name": "Delay Rate",
            "expression": "DIVIDE([Late Deliveries],[Delivered Orders])",
            "formatString": "0.0%",
            "displayFolder": "Commercial",
            "description": "Delay Rate"
          },
          {
            "name": "On Time Rate",
            "expression": "IF([Delivered Orders]>0,1-[Delay Rate])",
            "formatString": "0.0%",
            "displayFolder": "Commercial",
            "description": "On Time Rate"
          },
          {
            "name": "Open Orders",
            "expression": "COALESCE(CALCULATE(COUNTROWS(Orders),KEEPFILTERS(Orders[status] = \"open\")),0)",
            "formatString": "#,0",
            "displayFolder": "Commercial",
            "description": "Open Orders"
          },
          {
            "name": "Active Customers",
            "expression": "COALESCE(DISTINCTCOUNT(Orders[customer_id]),0)",
            "formatString": "#,0",
            "displayFolder": "Commercial",
            "description": "Active Customers"
          },
          {
            "name": "Booked Units",
            "expression": "CALCULATE(SUM(Orders[units]),KEEPFILTERS(Orders[status] <> \"cancelled\"))",
            "formatString": "#,0",
            "displayFolder": "Commercial",
            "description": "Booked Units"
          },
          {
            "name": "Warehouse Load",
            "expression": "AVERAGE(Orders[warehouse_load])",
            "formatString": "0.0%",
            "displayFolder": "Commercial",
            "description": "Warehouse Load"
          },
          {
            "name": "Prior Period Revenue",
            "expression": "VAR FirstDay=MIN('Date'[Date]) VAR LastDay=MAX('Date'[Date]) VAR Span=DATEDIFF(FirstDay,LastDay,DAY)+1 RETURN CALCULATE([Booked Revenue],REMOVEFILTERS('Date'),DATESBETWEEN('Date'[Date],FirstDay-Span,FirstDay-1))",
            "formatString": "\"â‚¹\" #,0.00;(\"â‚¹\" #,0.00);\"â‚¹\" 0.00",
            "displayFolder": "Commercial",
            "description": "Prior Period Revenue"
          },
          {
            "name": "Revenue Change",
            "expression": "IF([Prior Period Revenue]<>0,DIVIDE([Booked Revenue]-[Prior Period Revenue],[Prior Period Revenue]))",
            "formatString": "+0.0%;-0.0%;0.0%",
            "displayFolder": "Commercial",
            "description": "Revenue Change"
          },
          {
            "name": "Prior Month Revenue",
            "expression": "CALCULATE([Booked Revenue],DATEADD('Date'[Date],-1,MONTH))",
            "formatString": "\"â‚¹\" #,0.00;(\"â‚¹\" #,0.00);\"â‚¹\" 0.00",
            "displayFolder": "Commercial",
            "description": "Prior Month Revenue"
          },
          {
            "name": "Revenue MoM",
            "expression": "DIVIDE([Booked Revenue]-[Prior Month Revenue],[Prior Month Revenue])",
            "formatString": "+0.0%;-0.0%;0.0%",
            "displayFolder": "Commercial",
            "description": "Revenue MoM"
          },
          {
            "name": "Item Booked Revenue",
            "expression": "CALCULATE(SUM(Items[line_revenue]),KEEPFILTERS(Items[status]<>\"cancelled\"))",
            "formatString": "\"â‚¹\" #,0.00;(\"â‚¹\" #,0.00);\"â‚¹\" 0.00",
            "displayFolder": "Fulfillment",
            "description": "Item Booked Revenue"
          },
          {
            "name": "Product Delivered Orders",
            "expression": "CALCULATE(DISTINCTCOUNT(Items[order_id]),Items[status]=\"delivered\")",
            "formatString": "#,0",
            "displayFolder": "Fulfillment",
            "description": "Product Delivered Orders"
          },
          {
            "name": "Product Historical Delay",
            "expression": "IF([Product Delivered Orders]>=20,CALCULATE(AVERAGE(Items[late]),Items[status]=\"delivered\"))",
            "formatString": "0.0%",
            "displayFolder": "Fulfillment",
            "description": "Product Historical Delay"
          },
          {
            "name": "Open Scored Orders",
            "expression": "COALESCE(COUNTROWS('Open Risk'),0)",
            "formatString": "#,0",
            "displayFolder": "Fulfillment",
            "description": "Open Scored Orders"
          },
          {
            "name": "High Risk Open Orders",
            "expression": "VAR Cutoff=MAX('Model'[threshold]) RETURN COALESCE(COUNTROWS(FILTER('Open Risk','Open Risk'[risk_probability]>=Cutoff)),0)",
            "formatString": "#,0",
            "displayFolder": "Fulfillment",
            "description": "High Risk Open Orders"
          },
          {
            "name": "Risk Probability",
            "expression": "MAX('Open Risk'[risk_probability])",
            "formatString": "0.0%",
            "displayFolder": "Fulfillment",
            "description": "Risk Probability"
          },
          {
            "name": "Risk Threshold",
            "expression": "MAX('Model'[threshold])",
            "formatString": "0.0%",
            "displayFolder": "Fulfillment",
            "description": "Risk Threshold"
          },
          {
            "name": "Risk ROC AUC",
            "expression": "MAX('Model'[risk_auc])",
            "formatString": "0.000",
            "displayFolder": "Fulfillment",
            "description": "Risk ROC AUC"
          },
          {
            "name": "Risk Recall",
            "expression": "MAX('Model'[risk_recall])",
            "formatString": "0.0%",
            "displayFolder": "Fulfillment",
            "description": "Risk Recall"
          },
          {
            "name": "Segment Customers",
            "expression": "COUNT(Customers[frequency])",
            "formatString": "#,0",
            "displayFolder": "Customer snapshot",
            "description": "Segment Customers"
          },
          {
            "name": "Segment Lifetime Revenue",
            "expression": "SUM(Customers[monetary])",
            "formatString": "\"â‚¹\" #,0.00;(\"â‚¹\" #,0.00);\"â‚¹\" 0.00",
            "displayFolder": "Customer snapshot",
            "description": "Segment Lifetime Revenue"
          },
          {
            "name": "Mean Recency Days",
            "expression": "AVERAGE(Customers[recency])",
            "formatString": "0.0",
            "displayFolder": "Customer snapshot",
            "description": "Mean Recency Days"
          },
          {
            "name": "Mean Frequency",
            "expression": "AVERAGE(Customers[frequency])",
            "formatString": "0.0",
            "displayFolder": "Customer snapshot",
            "description": "Mean Frequency"
          },
          {
            "name": "Mean Customer Delay",
            "expression": "AVERAGE(Customers[late_rate])",
            "formatString": "0.0%",
            "displayFolder": "Customer snapshot",
            "description": "Mean Customer Delay"
          },
          {
            "name": "Forecast Units",
            "expression": "SUM(Forecast[units])",
            "formatString": "#,0.0",
            "displayFolder": "Planning",
            "description": "Forecast Units"
          },
          {
            "name": "Lower Heuristic",
            "expression": "SUM(Forecast[lower])",
            "formatString": "#,0.0",
            "displayFolder": "Planning",
            "description": "Lower Heuristic"
          },
          {
            "name": "Upper Heuristic",
            "expression": "SUM(Forecast[upper])",
            "formatString": "#,0.0",
            "displayFolder": "Planning",
            "description": "Upper Heuristic"
          },
          {
            "name": "One Day Test MAE",
            "expression": "MAX('Model'[forecast_mae])",
            "formatString": "#,0.0",
            "displayFolder": "Planning",
            "description": "One Day Test MAE"
          },
          {
            "name": "Seasonal Baseline MAE",
            "expression": "MAX('Model'[baseline_mae])",
            "formatString": "#,0.0",
            "displayFolder": "Planning",
            "description": "Seasonal Baseline MAE"
          },
          {
            "name": "Backtest Actual",
            "expression": "SUM(Backtest[actual])",
            "formatString": "#,0.0",
            "displayFolder": "Planning",
            "description": "Backtest Actual"
          },
          {
            "name": "Backtest Prediction",
            "expression": "SUM(Backtest[prediction])",
            "formatString": "#,0.0",
            "displayFolder": "Planning",
            "description": "Backtest Prediction"
          },
          {
            "name": "Backtest Baseline",
            "expression": "SUM(Backtest[seasonal_baseline])",
            "formatString": "#,0.0",
            "displayFolder": "Planning",
            "description": "Backtest Baseline"
          },
          {
            "name": "Monitoring Anomalies",
            "expression": "COALESCE(COUNTROWS(Anomalies),0)",
            "formatString": "#,0",
            "displayFolder": "Operations",
            "description": "Monitoring Anomalies"
          },
          {
            "name": "Anomaly Score",
            "expression": "MAX(Anomalies[anomaly_score])",
            "formatString": "0.000",
            "displayFolder": "Operations",
            "description": "Anomaly Score"
          },
          {
            "name": "Audit Rows",
            "expression": "SUM(Quality[Rows])",
            "formatString": "#,0",
            "displayFolder": "Operations",
            "description": "Audit Rows"
          },
          {
            "name": "Snapshot",
            "expression": "MAX(Orders[ordered_at])",
            "formatString": "dd MMM yyyy",
            "displayFolder": "Provenance",
            "description": "Snapshot"
          },
          {
            "name": "Pipeline Run",
            "expression": "SELECTEDVALUE('Model'[run_id])",
            "formatString": "",
            "displayFolder": "Provenance",
            "description": "Pipeline Run"
          },
          {
            "name": "Forecast Model",
            "expression": "SELECTEDVALUE('Model'[forecast_model])",
            "formatString": "",
            "displayFolder": "Planning",
            "description": "Forecast Model"
          },
          {
            "name": "Daily Load",
            "expression": "AVERAGE('Daily Operations'[warehouse_load])",
            "formatString": "0.0%",
            "displayFolder": "Fulfillment",
            "description": "Daily Load"
          },
          {
            "name": "Daily Delay",
            "expression": "AVERAGE('Daily Operations'[late_rate])",
            "formatString": "0.0%",
            "displayFolder": "Fulfillment",
            "description": "Daily Delay"
          },
          {
            "name": "Observed Revenue",
            "expression": "IF(COUNTROWS(Orders)>0,[Booked Revenue])",
            "formatString": "\"â‚¹\" #,0.00;(\"â‚¹\" #,0.00);\"â‚¹\" 0.00",
            "displayFolder": "Commercial",
            "description": "Booked revenue shown only where orders exist; prevents future calendar dates appearing as zero actuals."
          }
        ]
      },
      {
        "name": "Customers",
        "columns": [
          {
            "name": "customer_id",
            "dataType": "int64",
            "sourceColumn": "customer_id",
            "summarizeBy": "none",
            "formatString": "#,0"
          },
          {
            "name": "region",
            "dataType": "string",
            "sourceColumn": "region",
            "summarizeBy": "none"
          },
          {
            "name": "channel",
            "dataType": "string",
            "sourceColumn": "channel",
            "summarizeBy": "none"
          },
          {
            "name": "joined_at",
            "dataType": "dateTime",
            "sourceColumn": "joined_at",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy"
          },
          {
            "name": "last_order",
            "dataType": "dateTime",
            "sourceColumn": "last_order",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy"
          },
          {
            "name": "frequency",
            "dataType": "int64",
            "sourceColumn": "frequency",
            "summarizeBy": "none",
            "formatString": "#,0"
          },
          {
            "name": "monetary",
            "dataType": "double",
            "sourceColumn": "monetary",
            "summarizeBy": "none",
            "formatString": "#,0.00"
          },
          {
            "name": "late_rate",
            "dataType": "double",
            "sourceColumn": "late_rate",
            "summarizeBy": "none",
            "formatString": "#,0.00"
          },
          {
            "name": "recency",
            "dataType": "int64",
            "sourceColumn": "recency",
            "summarizeBy": "none",
            "formatString": "#,0"
          },
          {
            "name": "cluster",
            "dataType": "int64",
            "sourceColumn": "cluster",
            "summarizeBy": "none",
            "formatString": "#,0"
          },
          {
            "name": "segment",
            "dataType": "string",
            "sourceColumn": "segment",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Customers",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    C = SourceCustomers,\n    S = SourceSegments,\n    Joined = Table.NestedJoin(C,{\"customer_id\"},S,{\"customer_id\"},\"RFM\",JoinKind.LeftOuter),\n    Expanded = Table.ExpandTableColumn(Joined,\"RFM\",{\"last_order\",\"frequency\",\"monetary\",\"late_rate\",\"recency\",\"cluster\",\"segment\"})\nin Expanded"
            }
          }
        ]
      },
      {
        "name": "Products",
        "columns": [
          {
            "name": "product_id",
            "dataType": "int64",
            "sourceColumn": "product_id",
            "summarizeBy": "none",
            "formatString": "#,0"
          },
          {
            "name": "supplier_id",
            "dataType": "int64",
            "sourceColumn": "supplier_id",
            "summarizeBy": "none",
            "formatString": "#,0"
          },
          {
            "name": "product_name",
            "dataType": "string",
            "sourceColumn": "product_name",
            "summarizeBy": "none"
          },
          {
            "name": "category",
            "dataType": "string",
            "sourceColumn": "category",
